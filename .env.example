# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shikhar
POSTGRES_USER=shikhar
POSTGRES_PASSWORD=shikhar_dev
POSTGRES_POOL_MAX=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── NATS ─────────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── MSG91 (SMS / OTP) ────────────────────────────────────────────────────────
# Leave blank in dev to use console OTP logging instead.
MSG91_API_KEY=
MSG91_OTP_TEMPLATE_ID=

# ─── Gupshup (WhatsApp Business API) ─────────────────────────────────────────
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_PHONE=

# ─── Firebase Cloud Messaging ─────────────────────────────────────────────────
FCM_SERVICE_ACCOUNT_JSON=

# ─── Mapbox ───────────────────────────────────────────────────────────────────
MAPBOX_SECRET_TOKEN=
MAPBOX_PUBLIC_TOKEN=

# ─── Temporal.io ──────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=shikhar

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Exotel (Voice / IVR) ─────────────────────────────────────────────────────
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001,http://localhost:19006

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LIVE_TRACK_BASE_URL=http://localhost:3001/t
